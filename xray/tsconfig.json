{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@atoms/*": ["src/components/atoms/*"],
            "@components/*": ["src/components/*"],
            "@data/*": ["src/data/*"],
            "@layouts/*": ["src/layouts/*"],
            "@styles/*": ["src/styles/*"],
            "@types": ["src/types/index.d.ts"],
            "@lib/*": ["src/lib/*"],
        },
    },
}
